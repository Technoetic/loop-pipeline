      "input":[{"id":"a","menu":"아메리카노","customer":"민","paid":true,"cancelled":false,"price":3000,"quantity":2},{"id":"b","menu":"라테","customer":"수","paid":false,"cancelled":false,"price":4500,"quantity":1},{"id":"c","menu":"아메리카노","customer":"민","paid":true,"cancelled":true,"price":3000,"quantity":1}],
      "ops":[{"id":"amount","action":"amount","kind":"map","label":"단가 × 수량","description":"각 주문의 전체 금액 계산","code":".map(order => order.price * order.quantity)"},{"id":"sum","action":"sum","kind":"reduce","label":"합계 · 초기값 0","description":"숫자 배열을 합계 하나로","code":".reduce((total, amount) => total + amount, 0)"},{"id":"price","action":"price","kind":"map","label":"단가만","description":"수량을 반영하지 않은 단가","code":".map(order => order.price)"}],
