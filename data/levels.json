      "solution":[],"keepLoop":true,"cases":[[],[{"id":"x","quantity":2},{"id":"y","quantity":2},{"id":"z","quantity":1}],[{"id":"x","quantity":4},{"id":"y","quantity":3},{"id":"z","quantity":0}]]
