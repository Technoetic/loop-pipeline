      "input":[{"id":"a","menu":"아메리카노","customer":"민","paid":true,"cancelled":false,"price":3000,"quantity":2},{"id":"b","menu":"라테","customer":"수","paid":false,"cancelled":false,"price":4500,"quantity":1},{"id":"c","menu":"아메리카노","customer":"민","paid":true,"cancelled":true,"price":3000,"quantity":1}],
      "ops":[{"id":"active","action":"active","kind":"filter","label":"취소 제외","description":"cancelled가 false인 주문만 통과","code":".filter(order => !order.cancelled)"},{"id":"amount","action":"amount","kind":"map","label":"단가 × 수량","description":"각 주문의 전체 금액 계산","code":".map(order => order.price * order.quantity)"},{"id":"sum","action":"sum","kind":"reduce","label":"합계 · 초기값 0","description":"숫자 배열을 합계 하나로","code":".reduce((total, amount) => total + amount, 0)"},{"id":"paid","action":"paid","kind":"filter","label":"결제 완료","description":"paid가 true인 주문만 통과","code":".filter(order => order.paid)"}],
